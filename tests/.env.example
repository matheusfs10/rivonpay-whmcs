# Credenciais de integracao RivonPay (painel > GET /me/api-key).
# Copie para tests/.env e preencha. NUNCA versione o .env.
RIVONPAY_PK=
RIVONPAY_SK=

# Cliente usado na cobranca de teste.
TEST_NAME=Cliente Teste
TEST_EMAIL=teste@example.com
TEST_PHONE=61999999999
TEST_DOC_TYPE=CPF
TEST_DOC_NUMBER=

# Valor EM CENTAVOS (1000 = R$ 10,00).
TEST_AMOUNT_CENTS=1000

# Opcional: URL de captura para inspecionar o payload do webhook.
# TEST_POSTBACK_URL=https://webhook.site/SEU-ID

# Opcional: recebedor para testar split (--split-matrix).
# TEST_SPLIT_RECIPIENT=00000000-0000-4000-8000-000000000001
